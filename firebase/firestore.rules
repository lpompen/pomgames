rules_version = '2';
// PomGames: wie mag wat lezen en schrijven.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // BEHEERDER: vervang jouwnaam door jouw gebruikersnaam in kleine letters.
    // Meer beheerders: ['sam@pomgames.example', 'pom@pomgames.example']
    function isAdmin() { return signedIn() && request.auth.token.email in ['pompie@pomgames.example']; }

    // Gebruikersnamen: één keer claimen, daarna nooit meer wijzigen of verwijderen.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.lower() == name;
      allow update, delete: if false;
    }

    // Profielen: iedereen die is ingelogd ziet de spelerslijst. Je naam staat vast.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && request.resource.data.name is string
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.nameLower)).data.uid == uid;
      allow update: if isMe(uid)
        && request.resource.data.name == resource.data.name
        && request.resource.data.nameLower == resource.data.nameLower;
      allow delete: if false;

      // Push-adressen van je eigen toestellen: alleen jijzelf.
      match /tokens/{token} {
        allow read, write: if isMe(uid);
      }
    }

    // Gesprekken tussen twee spelers: alleen die twee kunnen ze lezen.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.type in ['text', 'buzz', 'invite']
          && (request.resource.data.type != 'text'
              || (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500));
        allow update, delete: if false;
      }
    }

    // Games die de beheerder heeft geïmporteerd: iedereen die is ingelogd mag ze spelen, alleen de beheerder mag ze wijzigen.
    match /games/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() && id.matches('^[a-z0-9]{2,24}$');
    }
    match /gamecode/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() && id.matches('^[a-z0-9]{2,24}$');
    }
    // Hiermee ziet de app of jij beheerder bent (lezen lukt alleen voor beheerders).
    match /admin/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Log van de laatste run: alleen de speler zelf (jij als beheerder ziet alles in de Firebase-console).
    match /logs/{uid} {
      allow read, write: if isMe(uid);
    }
  }
}
